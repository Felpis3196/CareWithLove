@page
@model LoginModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="mt-5" style="height: 80%; width: 350px; padding: 20px; border-radius: 15px; border: 1px solid #8c8c8c; margin: auto">
    <h1 class="text-center">@ViewData["Title"]</h1>
    <br />
    <div class="row">
        <div class="col-md-4" style="width: 85%; margin: auto; ">
            <form id="account" method="post">
                <div class="w-100 text-center"><h2>Entrar em uma conta</h2></div>

                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">E-mail</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="senha" />
                    <label asp-for="Input.Password" class="form-label">Senha</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg" style="background-color: #eb9b9a">Entrar</button>
                </div>
                <div>
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" style="color: #646a4a">Registrar uma nova conta</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


