@using CareWithLoveApp.Models.Entities
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<ul id="loginPartial" class="navbar-nav" style="background-color: #FFF0DF">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item p-2">
            <a class="nav-link text-dark" id="btnPerfil" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Olá @User.Identity?.Name</a>
        </li>
        <li class="nav-item p-2">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" id="btnSair" class="nav-link btn btn-link text-dark">Sair</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item p-2">
            <a class="nav-link text-dark" id="btnRegistro" asp-area="Identity" asp-page="/Account/Register">Registrar</a>
        </li>
        <li class="nav-item p-2">
            <a class="nav-link text-dark" id="btnEntrar" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
        </li>
    }
</ul>
