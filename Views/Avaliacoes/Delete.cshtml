@model CareWithLoveApp.Models.ViewModels.AvaliacaoViewModel

@{
    ViewData["Title"] = "Apagar";
}

<div class="m-5">


    <h1>@ViewData["Title"]</h1>
    <h3>Avaliação</h3>

    <h4>Você tem certeza de que quer apagar isso?</h4>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Nota)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Nota)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Review)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Review)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.UsuarioNome)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.UsuarioNome)
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="AvaliacaoId" />
            <input type="submit" value="Apagar" class="btn btn-danger" />
            <a class="btn btn-secondary ms-2" asp-action="Index">Voltar</a>
        </form>
    </div>

</div>