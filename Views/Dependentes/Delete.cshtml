@model CareWithLoveApp.Models.ViewModels.DependenteViewModel

@{
    ViewData["Title"] = "Apagar";
}

<h1>@ViewData["Title"]</h1>

<h3>Você tem certeza de que deseja apagar isso?</h3>
<div>
    <h4>Dependente</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DependenteNome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DependenteNome)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DependenteIdade)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DependenteIdade)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DependenteEndereco)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DependenteEndereco)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Insulina)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Insulina)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TelefoneEmergencia)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TelefoneEmergencia)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Cuidados)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Cuidados)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="DependenteId" />
        <input type="submit" value="Apagar" class="btn btn-danger" />
        <a class="btn btn-secondary ms-2" asp-action="Index">Voltar</a>
    </form>
</div>
