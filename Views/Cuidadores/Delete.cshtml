@model CareWithLoveApp.Models.ViewModel.CuidadorViewModel

@{
    ViewData["Title"] = "Apagar";
}

<h1>@ViewData["Title"]</h1>

<h3>Você tem certeza de que quer apagar isso?</h3>
<div>
    <h4>Cuidador</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CPF)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CPF)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Experiencia)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Experiencia)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ValorHora)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ValorHora)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Disponibilidade)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Disponibilidade)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Especializacoes)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Especializacoes)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CuidadorNome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Usuario.UsuarioNome)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="CuidadorId" />
        <input type="submit" value="Apagar" class="btn btn-danger" />
        <a class="btn btn-secondary ms-2" asp-action="Index">Voltar</a>
    </form>
</div>
