@model IEnumerable<CareWithLoveApp.Models.ViewModel.CuidadorViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Cuidadores</h1>

<div class="d-flex">
    @foreach (var item in Model)
    {
        <div class="card m-2 p-2" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">@Html.DisplayFor(modelItem => item.CuidadorNome)</h5>
                <p class="card-text">
                    Olá, sou @Html.DisplayFor(modelItem => item.Usuario.UsuarioNome),
                    especializado em @Html.DisplayFor(modelItem => item.Especializacoes)
                    a @Html.DisplayFor(modelItem => item.Experiencia)
                </p>
                <p>@Html.DisplayFor(modelItem => item.Usuario.UsuarioTelefone)</p>
                    <a class="btn text-white" style="background-color: #EC9440" asp-action="Edit" asp-route-id="@item.CuidadorId">
                        <svg bootstrap-icon="PencilSquare" width="20" height="20" aria-label="Editar"></svg>
                    </a>
            </div>
        </div>
    }
</div>

