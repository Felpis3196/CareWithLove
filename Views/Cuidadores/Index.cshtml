@model IEnumerable<CareWithLoveApp.Models.ViewModel.CuidadorViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Cuidadores</h1>

<div id="cudLinha" class="row">
    @foreach (var item in Model)
    {
        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
            <div class="card m-2 p-2" style="min-height: 200px">
                <div class="card-body">
                    <h5 class="card-title">@Html.DisplayFor(modelItem => item.CuidadorNome)</h5>
                    <p class="card-text">
                        Olá, sou @Html.DisplayFor(modelItem => item.Usuario.UsuarioNome),
                        especializado(a) em @Html.DisplayFor(modelItem => item.Especializacoes)
                        a @Html.DisplayFor(modelItem => item.Experiencia).
                        Minha disponibilidade é @Html.DisplayFor(modelItem => item.Disponibilidade),
                        e meu valor por hora é @Html.DisplayFor(modelItem => item.ValorHora).
                    </p>
                    <p>@Html.DisplayFor(modelItem => item.Usuario.UsuarioTelefone)</p>
                </div>
            </div>
        </div>
    }
</div>

