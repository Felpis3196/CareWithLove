@using CareWithLoveApp.Models.Entities
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    var usuarioAtual = await UserManager.GetUserAsync(User);
    var isCuidador = usuarioAtual != null && await UserManager.IsInRoleAsync(usuarioAtual, "Cuidador");

    var cuidadorId = usuarioAtual?.Cuidador?.CuidadorId;
}

<ul class="nav nav-pills flex-column">
    <li class="nav-item"><a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">Perfil</a></li>
    <li class="nav-item"><a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">Senha</a></li>
    @if (isCuidador)
    {
        <li class="nav-item"><a asp-action="Edit" asp-controller="Cuidadores" asp-route-id="@cuidadorId">Área Profissional</a></li>
    }
    else
    {
        
    }
</ul>
