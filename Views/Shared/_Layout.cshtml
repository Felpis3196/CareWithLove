@using CareWithLoveApp.Models.Entities
@using Microsoft.AspNetCore.Identity

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CareWithLoveApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="shortcut icon" type="image/svg" href="~/IMG/LogoIcon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CareWithLoveApp.styles.css" asp-append-version="true" />
</head>
<body class="">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light" style="background-color: #FFF0DF;">

            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/IMG/ImgLogo.png" style="height: 100px">
            </a>
            <button class="navbar-toggler m-2 " type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item p-2">
                        <a class="nav-link text-dark" id="home" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item p-2">
                        <a class="nav-link text-dark" id="cuidadores" asp-area="" asp-controller="Cuidadores" asp-action="Index">Cuidadores</a>
                    </li>
                    <li class="nav-item p-2" hidden="@(!User.Identity.IsAuthenticated)">
                        <a class="nav-link text-dark" id="dependentes" asp-area="" asp-controller="Dependentes" asp-action="Index">Dependentes</a>
                    </li>
                    <li class="nav-item p-2">
                        <a class="nav-link text-dark" id="home" asp-area="" asp-controller="Home" asp-action="QuemSomos">Quem Somos</a>
                    </li>
                </ul>
                <partial name="_LoginPartial" />
            </div>

        </nav>

    </header>
    <div class="container m-0 p-0" style="max-width: 100%">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center" style="background-color: #FFF0DF">
        <div class="container">
            &copy; 2024 - CareWithLoveApp
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.9.3/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>