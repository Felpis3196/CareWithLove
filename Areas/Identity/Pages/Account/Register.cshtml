@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrar";
}

<div class="mt-5" style="height: 80%; width: 350px; padding: 20px; border-radius: 15px; border: 1px solid #8c8c8c; margin: auto">
    <h1 class="text-center">@ViewData["Title"]</h1>
    <br />
    <div class="row">
        <div class="col-md-4" style="width: 85%; margin: auto; padding: 0 ">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div class="w-100 text-center"><h2>Criar uma nova conta</h2></div>
                <hr />

                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">E-mail</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.UsuarioNome" class="form-control" aria-required="true" placeholder="Your Name" />
                    <label asp-for="Input.UsuarioNome">Nome Completo</label>
                    <span asp-validation-for="Input.UsuarioNome" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <select asp-for="Input.UsuarioSexo" class="form-control" aria-required="true">
                        <option value="Masculino">Masculino</option>
                        <option value="Feminino">Feminino</option>
                        <option value="Outro">Outro</option>
                    </select>
                    <label asp-for="Input.UsuarioSexo">Gênero</label>
                    <span asp-validation-for="Input.UsuarioSexo" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.UsuarioTelefone" class="form-control" aria-required="true" placeholder="Número de telefone" />
                    <label asp-for="Input.UsuarioTelefone">Telefone</label>
                    <span asp-validation-for="Input.UsuarioTelefone" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.DataNascimento" class="form-control" type="date" aria-required="true" />
                    <label asp-for="Input.DataNascimento">Data de Nascimento</label>
                    <span asp-validation-for="Input.DataNascimento" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.UsuarioLogradouro" class="form-control" aria-required="true" placeholder="Endereço" />
                    <label asp-for="Input.UsuarioLogradouro">Endereço</label>
                    <span asp-validation-for="Input.UsuarioLogradouro" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <select asp-for="Input.UsuarioTipo" class="form-control" aria-required="true">
                        <option value="Cuidador">Cuidador</option>
                        <option value="Responsavel">Responsável por Dependentes</option>
                    </select>
                    <label asp-for="Input.UsuarioTipo">Tipo de Usuário</label>
                    <span asp-validation-for="Input.UsuarioTipo" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="senha" />
                    <label asp-for="Input.Password">Senha</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="senha" />
                    <label asp-for="Input.ConfirmPassword">Confirmar Senha</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <div>
                    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg" style="background-color: #eb9b9a">Registrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



