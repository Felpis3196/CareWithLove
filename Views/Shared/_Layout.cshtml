@using CareWithLoveApp.Models.Entities
@using Microsoft.AspNetCore.Identity

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CareWithLoveApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="shortcut icon" type="image/svg" href="~/IMG/LogoIcon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CareWithLoveApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3" style="background-color: #FFF0DF; height: 170px">
            <div class="container-fluid p-0 m-0">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/IMG/ImgLogo.png" style="height: 150px; width: 160px">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="IdNav" class="navbar-collapse collapse d-sm-inline-flex justify-content-between" style="background-color: #FFF0DF">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item p-2">
                            <a class="nav-link text-dark" id="home" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item p-2">
                            <a class="nav-link text-dark" id="cuidadores" asp-area="" asp-controller="Cuidadores" asp-action="Index">Cuidadores</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" id="" asp-area="" asp-controller="Cuidadores" asp-action="Perfil"></a>
                        </li>
                        <li class="nav-item p-2">
                            <a class="nav-link text-dark" id="dependentes" asp-area="" asp-controller="Dependentes" asp-action="Index">Dependentes</a>
                        </li>


                        <!--
                        <li class="nav-item">
                            <a class="nav-link text-dark" id="servCliente" asp-area="" asp-controller="ServicoClientes" asp-action="Index">ServicoClientes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" id="avaliacoes" asp-area="" asp-controller="Avaliacoes" asp-action="Index">Avaliações</a>
                        </li>-->


                    </ul>
                </div>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center" style="background-color: #FFF0DF;>
        <div class="container">
            &copy; 2024 - CareWithLoveApp
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>