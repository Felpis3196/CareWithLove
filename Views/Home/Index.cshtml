@{
	ViewData["Title"] = "Página Inicial";
}

<div class="text-center ">
	<div class="position-relative">

		<div id="carouselExampleAutoplaying" class="carousel slide m-auto" style="width: 80%" data-bs-ride="carousel">
			<div class="carousel-inner">
				<div class="carousel-item active">
					<img src="~/IMG/Cuid1.jpg" class="d-block w-100" alt="...">
				</div>
				<div class="carousel-item">
					<img src="~/IMG/Cuid2.jpg" class="d-block w-100" alt="...">
				</div>
				<div class="carousel-item">
					<img src="~/IMG/Cuid3.jpg" class="d-block w-100" alt="...">
				</div>
			</div>
			<button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev">
				<span class="carousel-control-prev-icon" aria-hidden="true"></span>
				<span class="visually-hidden">Previous</span>
			</button>
			<button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next">
				<span class="carousel-control-next-icon" aria-hidden="true"></span>
				<span class="visually-hidden">Next</span>
			</button>
		</div>
		<div class="position-absolute bottom-0">
			<h1 class="m-5">
				Seja bem-vindo ao Care With Love!
			</h1>
			<h2 class="m-5">
				O site que te ajuda a cuidar de quem te cuidou
			</h2>
		</div>
	</div>

	<br />

	<h5>
		A Care With Love foi especialmente desenvolvida para ser uma solução tecnológica<br />
		através da qual pessoas que precisam de CUIDADOS encontrem CUIDADORES.
	</h5>

	<br />
	<hr style="background-color: #eb9b9a; height: 20px; width: 100%" />
	<br />

	<div class="justify-content-center" id="Home">
		<h3>Nossos princípios consistem em:</h3>
		<div class="d-flex justify-content-center pt-2" id="nossosPrincipios">
			<ul class="text-start pe-5">
				<li>Empatia e Respeito</li>
				<li>Qualidade e Competência</li>
				<li>Transparência</li>
				<li>Segurança</li>
				<li>Personalização do Cuidado</li>
			</ul>
			<ul class="text-start">
				<li>Responsabilidade</li>
				<li>Flexibilidade</li>
				<li>Inovação</li>
				<li>Colaboração</li>
				<li>Apoio à Família</li>
			</ul>
		</div>
	</div>

	<br />
	<hr style="background-color: #eb9b9a; height: 20px; width: 100%" />
	<br />

	<div style="background-color: #FFF0DF; padding: 10px; border-radius: 15px">
		<h3 style="color: #eb9b9a; font-weight: bold">Telefones de emergência</h3>
		<div style="display:flex; justify-content: center; font-size:larger" id="TelEmerg">
			<div class="d-flex">
				<div class="p-4">
					<p style="color: #eb9b9a; font-weight: bold">193</p>
					<p>Bombeiros</p>
				</div>
				<div class="p-4">
					<p style="color: #eb9b9a; font-weight: bold">197</p>
					<p>Policia Civil</p>
				</div>
				<div class="p-4">
					<p style="color: #eb9b9a; font-weight: bold">181</p>
					<p>Disque denúncia</p>
				</div>
			</div>
			<div class="d-flex">
				<div class="p-4">
					<p style="color: #eb9b9a;font-weight: bold">192</p>
					<p>SAMU</p>
				</div>
				<div class="p-4">
					<p style="color: #eb9b9a; font-weight: bold">160</p>
					<p>Secretaria dasaúde</p>
				</div>

				<div class="p-4">
					<p style="color: #eb9b9a; font-weight: bold">150</p>
					<p>Vigilância sanitária</p>
				</div>
			</div>
		</div>
	</div>
</div>
